<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".widgets.impl.TodayWidget">

    <include layout="@layout/dashboard_widget_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <nodomain.freeyourgadget.gadgetbridge.activities.dashboard.DayClockView
            android:id="@+id/tile_day_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/tile_flow_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:flexWrap="wrap"
        app:justifyContent="center" />

</LinearLayout>
